{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Minidit",
	"version": "0.1.2",
	"identifier": "io.github.t-hamano.minidit",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"create": false,
				"title": "Minidit",
				"width": 800,
				"height": 600,
				"minWidth": 400,
				"minHeight": 300
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' data:",
				"font-src": "'self'",
				"connect-src": "'self' ipc: http://ipc.localhost",
				"object-src": "'none'",
				"base-uri": "'self'",
				"form-action": "'none'"
			}
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Aki Hamano",
		"createUpdaterArtifacts": true,
		"targets": [ "nsis", "app", "dmg" ],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"fileAssociations": [
			{
				"ext": [ "txt" ],
				"contentTypes": [ "public.plain-text" ],
				"name": "Text Document",
				"description": "Text Document",
				"mimeType": "text/plain",
				"role": "Editor"
			},
			{
				"ext": [ "md" ],
				"contentTypes": [ "net.daringfireball.markdown" ],
				"name": "Markdown Document",
				"description": "Markdown Document",
				"mimeType": "text/markdown",
				"role": "Editor"
			}
		],
		"macOS": {
			"minimumSystemVersion": "13.0"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBMkU3RTA2QUMzMjU3QjAKUldTd1Z6S3NCbjR1ZWpTRG9xdnVtNnl6U1lnQ2lhQ0QzWm4zRHF6M2wwa1Z0aTdPZEQwaUxocFUK",
			"endpoints": [
				"https://github.com/t-hamano/minidit/releases/latest/download/latest.json"
			]
		}
	}
}
